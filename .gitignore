# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

# Local game logs (observations, private conversations and memory)
/logs/
*.jsonl

# Local config, may hold API keys; each sits beside its example in a config/ directory
src/aiverse_server/*/config/*.yml
!src/aiverse_server/*/config/*.example.yml
